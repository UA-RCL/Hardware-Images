preplace netloc Q 1 2 1 980 320n
preplace netloc event_data_in_channel_halt 1 2 1 930 200n
preplace netloc event_data_out_channel_halt 1 2 1 940 220n
preplace netloc event_frame_started 1 2 1 790 240n
preplace netloc event_status_channel_halt 1 2 1 950 260n
preplace netloc event_tlast_missing 1 2 1 960 280n
preplace netloc event_tlast_unexpected 1 2 1 910 300n
preplace netloc pcie_rstn_1 1 0 3 10J 600 NJ 600 790J
preplace netloc util_ds_buf_0_IBUF_DS_ODIV2 1 2 1 970 570n
preplace netloc util_ds_buf_0_IBUF_OUT 1 2 1 990 590n
preplace netloc xdma_0_axi_aclk 1 1 3 390 60 890 720 1320
preplace netloc xdma_0_axi_aresetn 1 1 3 400 70 920 730 1310
preplace netloc xlconstant_0_dout 1 3 1 NJ 810
preplace netloc axi_stream_v_mult_0_m_axis 1 2 1 870 120n
preplace netloc pcie_ref_1 1 0 2 NJ 670 NJ
preplace netloc xdma_0_M_AXIS_H2C_0 1 1 3 410 80 990J 400 1310
