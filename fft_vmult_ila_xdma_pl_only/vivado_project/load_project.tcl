  set_property HDL_ATTRIBUTE.DEBUG {true} [get_bd_intf_nets xdma_0_M_AXIS_H2C_1]
  connect_bd_intf_net -intf_net xdma_0_M_AXIS_H2C_2 [get_bd_intf_pins xdma_0/M_AXIS_H2C_2] [get_bd_intf_pins axi_stream_v_mult_0/s_axis]
connect_bd_intf_net -intf_net [get_bd_intf_nets xdma_0_M_AXIS_H2C_2] [get_bd_intf_pins xdma_0/M_AXIS_H2C_2] [get_bd_intf_pins system_ila_0/SLOT_4_AXIS]
  set_property HDL_ATTRIBUTE.DEBUG {true} [get_bd_intf_nets xdma_0_M_AXIS_H2C_2]
  connect_bd_intf_net -intf_net xdma_0_pcie_mgt [get_bd_intf_ports pcie_mgt] [get_bd_intf_pins xdma_0/pcie_mgt]
  connect_bd_intf_net -intf_net xfft_0_M_AXIS_DATA [get_bd_intf_pins xdma_0/S_AXIS_C2H_0] [get_bd_intf_pins xfft_0/M_AXIS_DATA]
connect_bd_intf_net -intf_net [get_bd_intf_nets xfft_0_M_AXIS_DATA] [get_bd_intf_pins xdma_0/S_AXIS_C2H_0] [get_bd_intf_pins system_ila_0/SLOT_0_AXIS]
  set_property HDL_ATTRIBUTE.DEBUG {true} [get_bd_intf_nets xfft_0_M_AXIS_DATA]

  # Create port connections
  connect_bd_net -net Q [get_bd_pins c_counter_binary_0/Q] [get_bd_pins system_ila_0/probe6]
  set_property HDL_ATTRIBUTE.DEBUG {true} [get_bd_nets Q]
  connect_bd_net -net event_data_in_channel_halt [get_bd_pins xfft_0/event_data_in_channel_halt] [get_bd_pins system_ila_0/probe0]
  set_property HDL_ATTRIBUTE.DEBUG {true} [get_bd_nets event_data_in_channel_halt]
  connect_bd_net -net event_data_out_channel_halt [get_bd_pins xfft_0/event_data_out_channel_halt] [get_bd_pins system_ila_0/probe1]
  set_property HDL_ATTRIBUTE.DEBUG {true} [get_bd_nets event_data_out_channel_halt]
  connect_bd_net -net event_frame_started [get_bd_pins xfft_0/event_frame_started] [get_bd_pins system_ila_0/probe2]
  set_property HDL_ATTRIBUTE.DEBUG {true} [get_bd_nets event_frame_started]
  connect_bd_net -net event_status_channel_halt [get_bd_pins xfft_0/event_status_channel_halt] [get_bd_pins system_ila_0/probe3]
  set_property HDL_ATTRIBUTE.DEBUG {true} [get_bd_nets event_status_channel_halt]
  connect_bd_net -net event_tlast_missing [get_bd_pins xfft_0/event_tlast_missing] [get_bd_pins system_ila_0/probe4]
