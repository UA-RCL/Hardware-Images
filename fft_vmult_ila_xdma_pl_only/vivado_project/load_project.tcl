preplace netloc xdma_0_pcie_mgt 1 3 1 1340J 530n
preplace netloc xfft_0_M_AXIS_DATA 1 2 1 900 60n
levelinfo -pg 1 -10 200 610 1150 1390
pagesize -pg 1 -db -bbox -sgen -130 0 1600 870
"
}

  # Restore current instance
  current_bd_instance $oldCurInst

  validate_bd_design
  save_bd_design
  close_bd_design $design_name 
}
