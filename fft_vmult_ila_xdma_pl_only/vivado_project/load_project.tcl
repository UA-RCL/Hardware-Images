  connect_bd_net -net event_tlast_unexpected [get_bd_pins xfft_0/event_tlast_unexpected] [get_bd_pins system_ila_0/probe5]
  set_property HDL_ATTRIBUTE.DEBUG {true} [get_bd_nets event_tlast_unexpected]
  connect_bd_net -net pcie_rstn_1 [get_bd_ports pcie_rstn] [get_bd_pins xdma_0/sys_rst_n]
  connect_bd_net -net util_ds_buf_0_IBUF_DS_ODIV2 [get_bd_pins util_ds_buf_0/IBUF_DS_ODIV2] [get_bd_pins xdma_0/sys_clk]
  connect_bd_net -net util_ds_buf_0_IBUF_OUT [get_bd_pins util_ds_buf_0/IBUF_OUT] [get_bd_pins xdma_0/sys_clk_gt]
  connect_bd_net -net xdma_0_axi_aclk [get_bd_pins xdma_0/axi_aclk] [get_bd_pins xfft_0/aclk] [get_bd_pins system_ila_0/clk] [get_bd_pins axi_stream_v_mult_0/aclk] [get_bd_pins c_counter_binary_0/CLK]
  connect_bd_net -net xdma_0_axi_aresetn [get_bd_pins xdma_0/axi_aresetn] [get_bd_pins system_ila_0/resetn] [get_bd_pins xfft_0/aresetn] [get_bd_pins axi_stream_v_mult_0/aresetn]
  connect_bd_net -net xlconstant_0_dout [get_bd_pins xlconstant_0/dout] [get_bd_ports pcie_clkreq]

  # Create address segments

  # Perform GUI Layout
  regenerate_bd_layout -layout_string {
   "ActiveEmotionalView":"Default View",
   "Default View_ScaleFactor":"0.615738",
   "Default View_TopLeft":"-106,63",
   "ExpandedHierarchyInLayout":"",
   "guistr":"# # String gsaved with Nlview 7.5.8 2022-09-21 7111 VDI=41 GEI=38 GUI=JA:10.0 TLS
#  -string -flagsOSRD
preplace port pcie_ref -pg 1 -lvl 0 -x -10 -y 670 -defaultsOSRD
preplace port pcie_mgt -pg 1 -lvl 4 -x 1390 -y 540 -defaultsOSRD
