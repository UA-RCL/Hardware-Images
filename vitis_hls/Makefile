############################################################################
# HLS design targets for the PE-array program manager.
#
# Run from this directory. `make csim` is the fast, tool-free functional check;
# ./build_IPs.sh is the full Vitis HLS synthesis + IP packaging step.
#
# The design is two layers: program_manager.cpp owns the AXI-Lite registers and
# all targeting, pe_unit.hpp owns a single PE's timing and nothing else.
# `make pe-test` exercises a PE on its own; `make csim` exercises the whole grid.
############################################################################

IP_DIR   := program_manager
INC_DIR  := $(IP_DIR)/include
SRC_DIR  := $(IP_DIR)/src
TEST_DIR := $(IP_DIR)/test
BUILD    := build.csim

# Grid geometry. Changing these means re-running HLS and re-implementing the
# bitstream; `make layout-header` propagates them to pm-app.
GRID_DIM  ?= 8
MAX_BANKS ?= 4
DIMFLAGS  := -DDIM_X=$(GRID_DIM) -DDIM_Y=$(GRID_DIM) -DMAX_BANKS=$(MAX_BANKS)

PM_APP_DIR := ../petalinux/project-spec/meta-user/recipes-apps/pm-app/files
CXXFLAGS   := -std=c++11 -Wall -I$(INC_DIR) $(DIMFLAGS)

HDRS := $(wildcard $(INC_DIR)/*.hpp) $(wildcard $(INC_DIR)/*.h)

.PHONY: all test csim pe-test ip layout-header help clean

help:
	@echo "make test           pe-test + csim"
	@echo "make pe-test        unit test for a single PE (no manager, no grid)"
	@echo "make csim           functional C++ simulation of the whole grid"
	@echo "make ip             synthesize + package the HLS IP (runs ./build_IPs.sh)"
	@echo "make layout-header  regenerate pm_layout.h so pm-app matches the grid"
	@echo "make clean          remove simulation and HLS project artifacts"
	@echo ""
	@echo "GRID_DIM=$(GRID_DIM) MAX_BANKS=$(MAX_BANKS)   (override on the command line)"
	@echo "PE_FLAT=1 make ip   inline the PE back into the manager (fallback)"

all: test

test: pe-test csim

############## Single-PE unit test -- plain g++, no manager, no grid.
pe-test: $(TEST_DIR)/main_pe_unit.cpp $(HDRS)
	mkdir -p $(BUILD)
	g++ $(CXXFLAGS) $(TEST_DIR)/main_pe_unit.cpp -o $(BUILD)/pe_unit_test
	$(BUILD)/pe_unit_test

############## Functional C-simulation -- plain g++, no Vitis, no board.
# Compiles the same sources the HLS IP is built from; the #pragma HLS lines are
# ignored as unknown pragmas. Prints the PE occupancy map, which should match
# what pm-app prints on the target for the same command sequence.
csim: $(TEST_DIR)/main_csim.cpp $(SRC_DIR)/program_manager.cpp $(HDRS)
	mkdir -p $(BUILD)
	g++ $(CXXFLAGS) $(TEST_DIR)/main_csim.cpp $(SRC_DIR)/program_manager.cpp -o $(BUILD)/csim_test
	$(BUILD)/csim_test

############## Full HLS flow -> IPs/program_manager/ for the Vivado block design.
ip:
	GRID_DIM=$(GRID_DIM) MAX_BANKS=$(MAX_BANKS) ./build_IPs.sh

############## Keep pm-app's idea of the grid identical to the bitstream's.
# pm-app is built by bitbake out of its files/ directory and must not reach
# across the tree, so the header is generated here and committed.
layout-header:
	@printf '%s\n' \
	  '/* Generated by `make layout-header` in vitis_hls/ -- do not edit by hand.' \
	  ' * Keeps pm-app in step with the grid compiled into the bitstream. */' \
	  '#ifndef PM_LAYOUT_H' \
	  '#define PM_LAYOUT_H' \
	  '' \
	  '#define DIM_X        $(GRID_DIM)' \
	  '#define DIM_Y        $(GRID_DIM)' \
	  '#define MAX_BANKS    $(MAX_BANKS)' \
	  '#define NUM_CLUSTERS 2' \
	  '' \
	  '#endif' > $(PM_APP_DIR)/pm_layout.h
	@echo "wrote $(PM_APP_DIR)/pm_layout.h (GRID_DIM=$(GRID_DIM))"

clean:
	rm -rf $(BUILD)
	rm -rf $(IP_DIR)/program_manager_prj
	rm -f  vitis_hls.log $(IP_DIR)/vitis_hls.log
