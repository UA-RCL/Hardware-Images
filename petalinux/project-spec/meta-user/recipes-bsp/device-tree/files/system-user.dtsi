/include/ "system-conf.dtsi"

/ {
    udmabuf0: udmabuf@0x00 {
        compatible = "ikwzm,u-dma-buf";
        device-name = "udmabuf0";
        size = <0x00100000>;
    };

};

// &fft_0_dma    { compatible = "generic-uio"; };

&axi_ethernet_0 {
    phy-handle = <&phy0>;
    /delete-property/ pcs-handle;
    /delete-property/ managed;
    /delete-property/ xlnx,switch-x-sgmii;
    /delete-node/ mdio;
    axi_ethernet_mdio: mdio {
        #address-cells = <1>;
        #size-cells = <0>;
        phy0: phy@3 {
            device_type = "ethernet-phy";
            ti,sgmii-ref-clock-output-enable;
            ti,dp83867-rxctrl-strap-quirk;
            ti,rx-internal-delay = <0x8>;
            ti,tx-internal-delay = <0xa>;
            ti,fifo-depth = <0x1>;
            reg = <3>;
        };
    };
};

&axi_ethernet_0 {
    pcs-handle = <&pcs_phy>;
};

&axi_ethernet_mdio {
    pcs_phy: ethernet-phy@1 {
        compatible = "ethernet-phy-id0174.0c00";
        reg = <1>;
    };
};
